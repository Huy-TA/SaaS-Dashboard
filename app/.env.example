# Chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# ── Google Sheets (service account cần quyền Viewer trên Sheet) ──
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Một dòng, giữ nguyên \n — code tự đổi thành xuống dòng thật
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Đăng nhập Google (NextAuth) ──
# Chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# OAuth Client (Google Cloud → Credentials → OAuth client ID → Web application)
# Redirect URI: http://localhost:3000/api/auth/callback/google (+ địa chỉ deploy)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email được vào, phân tách bằng dấu phẩy; "@congty.vn" cho cả tên miền
ALLOWED_EMAILS=
# Khi deploy (ví dụ Vercel): địa chỉ thật của dashboard
# NEXTAUTH_URL=https://ten-mien-cua-ban
