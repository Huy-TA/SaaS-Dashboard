# Chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# Service account cần được share quyền Viewer trên Google Sheet.

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Một dòng, giữ nguyên \n — code tự đổi thành xuống dòng thật
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
